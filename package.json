{
  "name": "spraydown",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/main.ts",
    "dev": "nodemon server/main.ts --dev",
    "build": "vite build && vite build --mode studio && vite build --ssr",
    "watch": "vite build --watch",
    "static": "node scripts/build-static.mjs",
    "release": "node scripts/check-release.mjs && pnpm build && pnpm static",
    "tsc": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.server.json",
    "lint": "eslint . && node scripts/check-conventions.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:services": "node --env-file=test/services.env --test test/*.test.ts",
    "worker": "node server/worker.ts"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "@types/howler": "~2.2.11",
    "bullmq": "6.3.11",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "compression": "^1.8.2",
    "express": "5.3.0",
    "howler": "~2.2.4",
    "i18next": "26.5.6",
    "ioredis": "6.0.0",
    "konva": "^10.9.0",
    "lucide-react": "1.61.0",
    "morgan": "1.12.1",
    "multer": "2.5.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.3",
    "react-konva": "19.3.2",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "sqlite3": "^6.0.1",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "marked": "18.1.1",
    "msw": "^3.0.3",
    "nodemon": "~3.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.5"
  },
  "nodemonConfig": {
    "watch": [
      "server/",
      "shared/"
    ],
    "ext": "ts",
    "execMap": {
      "ts": "node"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
