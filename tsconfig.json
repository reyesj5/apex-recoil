{
  // Browser code in client/. Vite bundles it; tsc only typechecks (pnpm tsc).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    // "cn" is the design-token-aware `cn` in client/lib/utils.ts (shadcn/ui components import it as "cn")
    "paths": { "@/*": ["./client/*"], "cn": ["./client/lib/utils.ts"] }
  },
  "include": ["client"]
}
