# Copy to .env (read by `pnpm start` and `pnpm worker`) and uncomment what you need.
# With none of these set, the app runs analysis jobs in-process and keeps captures in
# processing/captures, with no other services required.

# --- Job queue: Redis/BullMQ (docker compose up -d redis) -----------------------------------
# Jobs survive server restarts and can run on several workers (`pnpm worker`).
# REDIS_URL=redis://127.0.0.1:6379
# RECOIL_QUEUE_PREFIX=spraydown         # Redis key prefix
# RECOIL_EMBEDDED_WORKER=true           # false: only `pnpm worker` processes run jobs
# RECOIL_WORKER_CONCURRENCY=3           # default: CPU cores - 1, at most 4

# --- Capture storage: S3-compatible (docker compose up -d s3) -------------------------------
# Needed for workers on other machines; browsers then upload clips straight to the bucket.
# STORAGE_PROVIDER=s3
# S3_BUCKET=spraydown
# S3_ENDPOINT=http://127.0.0.1:8333      # omit for AWS S3
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true               # default: true when S3_ENDPOINT is set
# S3_ACCESS_KEY_ID=spraydown-dev         # omit to use the AWS SDK credential chain
# S3_SECRET_ACCESS_KEY=spraydown-dev-secret
# S3_AUTO_CREATE_BUCKET=true             # development: create the bucket and its CORS rule
# S3_CORS_ORIGINS=http://localhost:3000  # origins allowed to upload directly (default *)
# STORAGE_PUBLIC_URL=                    # serve captures from a CDN/public bucket instead of /captures
# RECOIL_UPLOAD_SECRET=                  # shared secret if several API instances accept uploads

# --- Other ------------------------------------------------------------------------------------
# PORT=3000
# PYTHON=python                          # interpreter for analysis jobs
# RECOIL_DB_PATH=data/recoil.db
# RECOIL_SPECS_PATH=client/specs.json
# RECOIL_CAPTURES_DIR=processing/captures
# RECOIL_UPLOAD_TMP_DIR=                 # default: <system temp>/spraydown_uploads
