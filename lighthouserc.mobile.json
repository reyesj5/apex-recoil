{
  "ci": {
    "collect": {
      "startServerCommand": "node e2e/server.mjs",
      "startServerReadyPattern": "e2e server on",
      "url": [
        "http://127.0.0.1:3210/",
        "http://127.0.0.1:3210/patterns",
        "http://127.0.0.1:3210/progress",
        "http://127.0.0.1:3210/faq"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-results/mobile"
    }
  }
}
