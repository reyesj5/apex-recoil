{
  "about": "Written by `python scripts/agent_kit.py install`, never by hand: what the agent kit added to this project, so a later install takes back only its own, and where the kit is, for `python scripts/agent_kit.py outdated`.",
  "repository": "github.com/SphyrLabs/llm-workflow",
  "folder": "agent-kit",
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr status*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(gh auth status*)",
      "PowerShell(gh run list*)",
      "PowerShell(gh run view*)",
      "PowerShell(gh run watch*)",
      "PowerShell(gh pr checks*)",
      "PowerShell(gh pr view*)",
      "PowerShell(gh pr list*)",
      "PowerShell(gh pr status*)",
      "PowerShell(gh workflow list*)",
      "PowerShell(gh workflow view*)",
      "PowerShell(gh auth status*)"
    ],
    "deny": [
      "Bash(gh pr create*)",
      "Bash(gh pr new*)",
      "PowerShell(gh pr create*)",
      "PowerShell(gh pr new*)"
    ]
  },
  "gitignore": [
    "*.graphify-bak",
    ".claude/logs/",
    ".claude/settings.local.json",
    ".claude/worktrees/"
  ]
}
