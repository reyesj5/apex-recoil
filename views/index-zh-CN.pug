extends layout

block content
  #game
    #control
      h1 Apex Legends 后坐力弹道
      p.description 练习连射控枪
      p#sensitivity-warning.hidden
        | 练习区域太小了! #[a(href="https://github.com/metaflow/apex-recoil/blob/main/docs/faq.md#mouse-sensitivity" target="_blank") 如何修复] 
      #top-links
        p#show-instructions-btn.action
          | 显示说明
        a(href="/editor")
          | 压枪编辑器 🛠️
        a(href="https://github.com/metaflow/apex-recoil/blob/main/docs/faq.md" target="_blank")
          | FAQ
        a(href="https://www.paypal.com/donate/?hosted_button_id=ZM3AS9J6VDYVN" target="_blank")
          | 支援 ❤️
      #score
        div#stats-graph-btn.tooltip.btn
          img(src="/outline_insert_chart_white_48dp.png"  alt="show graph")
          .tooltiptext 显示历史成绩
        div#stats-wrap
          p#score-stats
      #weapon-select.grid
        div.flatline.btn(data-weapon="flatline")
          img(src="/images/flatline.png", alt="flatline")
          p.name 平行步枪
        div.r301.btn(data-weapon="r301")
          img(src="/images/r301.png", alt="r-301")
          p.name R-301
        div.havoc_tc.btn(data-weapon="havoc_tc")
          img(src="/images/havoc.png", alt="havoc")
          p.name 哈沃克步枪
        div.hemlok.btn(data-weapon="hemlok")
          img(src="/images/hemlok.png", alt="hemlok")
          p.name 赫姆洛克
        div.nemesis.btn(data-weapon="nemesis")
          img(src="/images/nemesis.svg", alt="nemesis")
          p.name 复仇女神
        div.alternator.btn(data-weapon="alternator")
          img(src="/images/alternator.png", alt="alternator")
          p.name 转换者冲锋枪
        div.prowler.btn(data-weapon="prowler")
          img(src="/images/prowler.png", alt="prowler")
          p.name 猎手冲锋枪
        div.r99.btn(data-weapon="r99")
          img(src="/images/r99.png", alt="r-99")
          p.name R-99
        div.volt.btn(data-weapon="volt")
          img(src="/images/volt.png", alt="volt")
          p.name 电能冲锋枪
        div.car.btn(data-weapon="car")
          img(src="/images/car.png", alt="car")
          p.name C.A.R.
        div.devotion_tc.btn(data-weapon="devotion_tc")
          img(src="/images/devotion.png", alt="devotion")
          p.name 专注轻机枪
        div.lstar.btn(data-weapon="lstar")
          img(src="/images/lstar.png", alt="lstar")
          p.name L-STAR
        div.spitfire.btn(data-weapon="spitfire")
          img(src="/images/spitfire.png", alt="spitfire")
          p.name 喷火轻机枪
        div.rampage.btn(data-weapon="rampage")
          img(src="/images/rampage.png", alt="rampage")
          p.name 暴走轻机枪
        div.g7_scout.btn(data-weapon="g7_scout")
          img(src="/images/g7_scout.svg", alt="g7 scout")
          p.name G7侦灵枪
        div.triple_take.btn(data-weapon="triple_take")
          img(src="/images/triple_take.svg", alt="triple take")
          p.name 三重击
        div.btn(data-weapon="3030_repeater" class="w-3030_repeater")
          img(src="/images/3030_repeater.svg", alt="30-30 repeater")
          p.name 30-30连发枪
        div.bocek.btn(data-weapon="bocek")
          img(src="/images/bocek.svg", alt="bocek")
          p.name 波塞克复合弓
        div.charge_rifle.btn(data-weapon="charge_rifle")
          img(src="/images/charge_rifle.svg", alt="charge rifle")
          p.name 充能步枪
        div.longbow.btn(data-weapon="longbow")
          img(src="/images/longbow.svg", alt="longbow")
          p.name 长弓精确步枪
        div.sentinel.btn(data-weapon="sentinel")
          img(src="/images/sentinel.svg", alt="sentinel")
          p.name 哨兵狙击枪
        div.kraber.btn(data-weapon="kraber")
          img(src="/images/kraber.svg", alt="kraber")
          p.name 克雷贝尔
        div.eva8.btn(data-weapon="eva8")
          img(src="/images/eva8.svg", alt="eva8")
          p.name EVA-8连发霰弹枪
        div.mastiff.btn(data-weapon="mastiff")
          img(src="/images/mastiff.svg", alt="mastiff")
          p.name 敖犬霰弹枪
        div.mozambique.btn(data-weapon="mozambique")
          img(src="/images/mozambique.svg", alt="mozambique")
          p.name 莫桑比克
        div.mozambique_akimbo.btn(data-weapon="mozambique_akimbo")
          img(src="/images/mozambique_akimbo.svg", alt="mozambique akimbo")
          p.name 莫桑比克 (双持)
        div.peacekeeper.btn(data-weapon="peacekeeper")
          img(src="/images/peacekeeper.svg", alt="peacekeeper")
          p.name 和平捍卫者
        div.re45.btn(data-weapon="re45")
          img(src="/images/re45.png", alt="re45")
          p.name RE-45
        div.p2020.btn(data-weapon="p2020")
          img(src="/images/p2020.svg", alt="p2020")
          p.name P2020
        div.p2020_akimbo.btn(data-weapon="p2020_akimbo")
          img(src="/images/p2020_akimbo.svg", alt="p2020 akimbo")
          p.name P2020 (双持)
        div.wingman.btn(data-weapon="wingman")
          img(src="/images/wingman.svg", alt="wingman")
          p.name 辅助手枪
      #fire-mode-select.button-row
        div.fire-mode-btn.fire-mode-auto.tooltip(data-mode="auto")
          span.fire-mode-icon ⮓⮓⮓
          span.fire-mode-text 全自动
          span.tooltiptext 全自动射击
        div.fire-mode-btn.fire-mode-burst.tooltip(data-mode="burst")
          span.fire-mode-icon ⮓⮓
          span.fire-mode-text 连发
          span.tooltiptext 点射连发
        div.fire-mode-btn.fire-mode-single.tooltip(data-mode="single")
          span.fire-mode-icon ⮓
          span.fire-mode-text 单发
          span.tooltiptext 单发射击
        div.fire-mode-hint.tooltip
          span.fire-mode-key [B]
          span.tooltiptext 切换射击模式 [B]
      #mag-select.button-row
        div.mag-0.tooltip
          img(src="/images/magi.png" alt="no magazine")
          span.tooltiptext 无扩容
        div.mag-1.tooltip
          img(src="/images/magi.png" alt="magazine level 1")
          span.tooltiptext 等级1
        div.mag-2.tooltip
          img(src="/images/magi.png" alt="magazine level 2")
          span.tooltiptext 等级2
        div.mag-3.tooltip
          img(src="/images/magi.png" alt="magazine level 3")
          span.tooltiptext 等级3
        div.mag-4.tooltip
          img(src="/images/magi.png" alt="corrupted magazine")
          span.tooltiptext 异变弹匣 (Corrupted)
        div.mag-drop.tooltip.hidden
          img(src="/images/magi.png" alt="drop magazine")
          span.tooltiptext 固定弹容量
        div.mod-revved_up.mod.hidden.tooltip
          img(src="/images/thermite_grenade.png" alt="thermite grenade")
          span.tooltiptext 装填铝热剂
        div.mod-corrupted_stock.mod.tooltip
          img(src="/images/barrel_stocki.png" alt="corrupted stock")
          span.tooltiptext 异变枪托 (-4发备弹, 霰弹枪-1发)
      #settings
          #mouse-settings.row
            div
              input(type='text' id='sens')
              span.tooltip.underlined
                | 灵敏度
                span.tooltiptext
                  | 例如: 鼠标灵敏度3和游戏中ADS<br/>
                  | 1.2 在此设置为 3 * 1.2 = 3.6
            div.scale-x-wrapper
              input(type='text' id='scale-x')
              span
                | x&nbsp;
            div
              input(type='text' id='scale-y')
              span
                | 比例
            #invert-y-btn.btn
              div 反转 Y 轴
          p 模式:
          #mode-selection.button-row
            #mode-fixed-path.btn.tooltip
              div 跟随弹道
              span.tooltiptext 点击区域中任意位置<br/>快捷键 [a]
            #mode-fixed.btn.tooltip
              div 静止目标
              span.tooltiptext 点击区域中任意位置<br/>快捷键 [s]
            #mode-moving.btn.tooltip
              div 移动目标
              span.tooltiptext 快捷键 [d]
          div.row
            .tooltip
              img(src="/outline_run_circle_white_24dp.png" alt="target control")
              span.tooltiptext
                | 目标移动速度
            input.slider#target-speed(type='range' min="1" max="600" step="1")
            #target-speed-value.value
          #recoil-mode.button-row
            .center-text 后坐力:
            #recoil-weapon.btn.tooltip
              div 武器
              span.tooltiptext
                | 对武器施加后坐力且<br/>
                | 保持目标静止（或平滑移动）
            #recoil-target.btn.tooltip
              div 目标
              span.tooltiptext
                | 对目标施加后坐力。<br/>
                | 更贴近游戏中体验
          .button-row
            .center-text 结果风格:
            #trace-0.btn
              div 目标
            #trace-1.btn
              div 路径-点
            #trace-2.btn
              div 路径-线
          .row
            .tooltip
              img(src="/outline_slow_motion_video_white_24dp.png" alt="speed control").tooltip
              span.tooltiptext
                | 开火速度。如果你无法控制后坐，可以尝试减速。
            input.slider#speed(type='range' min="10" max="100" step="10")
            #speed-value.value
          #sound-control.row
            #toggle-mute.tooltip
              img(src="/volume_up_white_24dp.svg"  alt="sound is not muted")#unmuted
              img(src="/volume_off_white_24dp.svg" alt="sound is muted")#muted.hidden
              span.tooltiptext
                | 音量 (点击静音)
            input.slider#volume(type='range' min="0" max="100")
            .value
      #controls-bottom
        #copyright
          div.links
            a(href="https://github.com/metaflow/apex-recoil" target="_blank")
              img(src="/GitHub-Mark-Light-32px.png", alt="github")
            a(href="https://www.reddit.com/r/apexlegends/comments/mosk0l/i_have_created_an_app_to_practice_recoils/" target="_blank")
              img(src="/reddit.png", alt="reddit")
            a(href="/").lang
              | english
            a(href="/ru").lang
              | русский
            div.vertical
              a(href="https://github.com/metaflow/apex-recoil/blob/main/docs/privacy-policy.md" target="_blank")
                | Privacy Policy
              a(href="https://github.com/metaflow/apex-recoil/blob/main/docs/privacy-policy-de.md" target="_blank")
                | Datenschutzerklärung
              a(href="#cookies")
                | Cookie settings
          p
            | 2024 by Mikhail equanimity_rulez Goncharov.
          p
            | This app is not affiliated with or sponsored by Electronic Arts Inc. or its licensors. 
            | Game content and materials are trademarks and copyrights of 
            | #[a(href="https://ea.com" target="_blank") Electronic Arts Inc.]              
            | or #[a(href="https://www.respawn.com/" target="_blank") Respawn Entertainment]. 
            | Some images and reference materials come from 
            | #[a(href="https://apexlegends.fandom.com/wiki/" target="_blank") Apex Legends Wiki].
        #version
          p
            | version #[span#version-value 17]&nbsp;
            a(href="https://github.com/metaflow/apex-recoil/blob/main/docs/release-notes.md" target="_blank")
              | what's new
    #workspace
      #detailed-stats.hidden
        div 请注意，Y 轴分数是取对数的，因为从 40 分提高到 50 分很容易，但从 90 分提高到 92 分要困难得多。
        #plotly_area
        div
          p.action#hide-stats 关闭图表
      #instructions.hidden
          h2 说明
          p 在Youtube上 #[a(href="https://www.youtube.com/watch?v=tTPKHa4aXug") 查看简介].
          ul
            li #[a(href="https://www.google.com/search?q=turn+off+enhance+pointer+precision" target="_blank") 确保“增强鼠标精度”选项已关闭].
            li 设置 #[i 灵敏度].&nbsp;
              a(href="https://github.com/metaflow/apex-recoil/blob/main/docs/faq.md#controller-support" target="_blank") 手柄设置办法.
            li 选择武器和弹夹。
            li 点击下方虚线区域并尝试控枪。
            li 你控制的越好分数就越高。最高为100分。           
          p 鼠标悬停在选项上可以看到提示 (如果有的话).
          p.action#dismiss-instructions 关闭说明
      #stage
  #mobile-info 
    h1 Apex Legends 后坐力弹道
    p 你好! 感谢你使用这个小程序来练习后坐力弹道. 它旨在通过鼠标或者手柄在电脑浏览器上使用。
      | 您的屏幕宽度必须大于900像素。
      | 同时请看Reddit上
      | #[a(href="https://www.reddit.com/r/apexlegends/comments/mosk0l/i_have_created_an_app_to_practice_recoils/") 这个帖子] 
      | and #[a(href="https://github.com/metaflow/apex-recoil/blob/main/docs/faq.md") FAQ].
    br
    p Cheers!
    img(src="/trail.png", alt="trail")
    #copyright-mobile
      p
        a(href="https://github.com/metaflow/apex-recoil/blob/main/docs/privacy-policy.md" target="_blank")
          | Privacy Policy
      p
        a(href="https://github.com/metaflow/apex-recoil/blob/main/docs/privacy-policy-de.md" target="_blank")
          | Datenschutzerklärung
      p
        a(href="#cookies")
          | Cookie settings
      p 2024 equanimity_rulez
      p This app is not affiliated with or sponsored by Electronic Arts Inc. or its licensors.
  script.
    window.game_locale = 'zh-CN';