extends layout
include mixins/icons

block content
  #game(class="flex flex-row h-full mobile:hidden")
    #control(class="flex flex-col min-w-[315px] max-w-[315px] bg-menu")
      h1 Отдача оружия в Apex Legends
      p(class="px-1 text-center") Практическое обучение
      p#sensitivity-warning.hidden(class="p-2 text-center text-error")
        if site.faqUrl
          | Активная зона слишком мала! Может быть расширить окно? #[a(href=site.faqUrl+'#mouse-sensitivity' target="_blank" rel="noopener noreferrer") еще (англ.)] 
        else
          | Активная зона слишком мала! Может быть расширить окно?
      #top-links(class="flex justify-around px-3 py-1")
        p#show-instructions-btn.action
          | Инструкции
        a(href="/editor")
          +icon('wrench')
          |  Студия отдачи
        if site.faqUrl
          a(href=site.faqUrl target="_blank" rel="noopener noreferrer")
            | FAQ (англ.)
        if site.supportUrl
          a(href=site.supportUrl target="_blank" rel="noopener noreferrer")
            +icon('heart')
            |  Поддержать
      #score(class="flex flex-row px-2 py-1")
        div#stats-graph-btn.tooltip.btn(class="mr-1" aria-label="Показать график статистики")
          img(src="/outline_insert_chart_white_48dp.png" alt="show graph")
          .tooltiptext Статистика
        div#stats-wrap(class="m-auto text-right")
          p#score-stats
      #weapon-filter-bar(class="flex flex-col gap-[5px] px-[6px] py-1 mb-1")
        input#weapon-search-input(type="text" placeholder="Поиск оружия..." autocomplete="off" aria-label="Поиск оружия")
        .weapon-category-pills(class="flex flex-wrap gap-[3px]" role="tablist" aria-label="Категории оружия")
          button.cat-pill.active(type="button" data-category="all") Все
          button.cat-pill(type="button" data-category="ar") AR
          button.cat-pill(type="button" data-category="smg") SMG
          button.cat-pill(type="button" data-category="lmg") LMG
          button.cat-pill(type="button" data-category="marksman") Марксм.
          button.cat-pill(type="button" data-category="sniper") Снайпер.
          button.cat-pill(type="button" data-category="shotgun") Дробов.
          button.cat-pill(type="button" data-category="pistol") Пистол.
      #weapon-select(class="flex flex-row flex-wrap justify-between")
        div.flatline.btn(data-weapon="flatline" data-category="ar")
          img(src="/images/flatline.png", alt="flatline")
          p.name Флэтлайн
        div.r301.btn(data-weapon="r301" data-category="ar")
          img(src="/images/r301.png", alt="r-301")
          p.name R-301
        div.havoc_tc.btn(data-weapon="havoc_tc" data-category="ar")
          img(src="/images/havoc.png", alt="havoc")
          p.name ХАОС
        div.hemlok.btn(data-weapon="hemlok" data-category="ar")
          img(src="/images/hemlok.png", alt="hemlok")
          p.name Хемлок
        div.nemesis.btn(data-weapon="nemesis" data-category="ar")
          img(src="/images/nemesis.svg", alt="nemesis")
          p.name Немезида
        div.alternator.btn(data-weapon="alternator" data-category="smg")
          img(src="/images/alternator.png", alt="alternator")
          p.name Сменщик
        div.prowler.btn(data-weapon="prowler" data-category="smg")
          img(src="/images/prowler.png", alt="prowler")
          p.name Ищейка
        div.r99.btn(data-weapon="r99" data-category="smg")
          img(src="/images/r99.png", alt="r-99")
          p.name R-99
        div.volt.btn(data-weapon="volt" data-category="smg")
          img(src="/images/volt.png", alt="volt")
          p.name Вольт
        div.car.btn(data-weapon="car" data-category="smg")
          img(src="/images/car.png", alt="car")
          p.name C.A.R.
        div.devotion_tc.btn(data-weapon="devotion_tc" data-category="lmg")
          img(src="/images/devotion.png", alt="devotion")
          p.name Преданность
        div.lstar.btn(data-weapon="lstar" data-category="lmg")
          img(src="/images/lstar.png", alt="lstar")
          p.name L-STAR
        div.spitfire.btn(data-weapon="spitfire" data-category="lmg")
          img(src="/images/spitfire.png", alt="spitfire")
          p.name Спитфайр
        div.rampage.btn(data-weapon="rampage" data-category="lmg")
          img(src="/images/rampage.png", alt="rampage")
          p.name Неистовство
        div.g7_scout.btn(data-weapon="g7_scout" data-category="marksman")
          img(src="/images/g7_scout.svg", alt="g7 scout")
          p.name G7 Скаут
        div.triple_take.btn(data-weapon="triple_take" data-category="marksman")
          img(src="/images/triple_take.svg", alt="triple take")
          p.name Тройной эффект
        div.btn(data-weapon="3030_repeater" class="w-3030_repeater" data-category="marksman")
          img(src="/images/3030_repeater.svg", alt="30-30 repeater")
          p.name 30-30
        div.bocek.btn(data-weapon="bocek" data-category="marksman")
          img(src="/images/bocek.svg", alt="bocek")
          p.name Лук Босек
        div.charge_rifle.btn(data-weapon="charge_rifle" data-category="sniper")
          img(src="/images/charge_rifle.svg", alt="charge rifle")
          p.name Энерговинтовка
        div.longbow.btn(data-weapon="longbow" data-category="sniper")
          img(src="/images/longbow.svg", alt="longbow")
          p.name Длинный лук
        div.sentinel.btn(data-weapon="sentinel" data-category="sniper")
          img(src="/images/sentinel.svg", alt="sentinel")
          p.name Страж
        div.kraber.btn(data-weapon="kraber" data-category="sniper")
          img(src="/images/kraber.svg", alt="kraber")
          p.name Крабер
        div.eva8.btn(data-weapon="eva8" data-category="shotgun")
          img(src="/images/eva8.svg", alt="eva8")
          p.name EVA-8
        div.mastiff.btn(data-weapon="mastiff" data-category="shotgun")
          img(src="/images/mastiff.svg", alt="mastiff")
          p.name Мастиф
        div.mozambique.btn(data-weapon="mozambique" data-category="shotgun")
          img(src="/images/mozambique.svg", alt="mozambique")
          p.name Мозамбик
        div.mozambique_akimbo.btn(data-weapon="mozambique_akimbo" data-category="shotgun")
          img(src="/images/mozambique_akimbo.svg", alt="mozambique akimbo")
          p.name Мозамбик (Акимбо)
        div.peacekeeper.btn(data-weapon="peacekeeper" data-category="shotgun")
          img(src="/images/peacekeeper.svg", alt="peacekeeper")
          p.name Миротворец
        div.re45.btn(data-weapon="re45" data-category="pistol")
          img(src="/images/re45.png", alt="re45")
          p.name RE-45
        div.p2020.btn(data-weapon="p2020" data-category="pistol")
          img(src="/images/p2020.svg", alt="p2020")
          p.name P2020
        div.p2020_akimbo.btn(data-weapon="p2020_akimbo" data-category="pistol")
          img(src="/images/p2020_akimbo.svg", alt="p2020 akimbo")
          p.name P2020 (Акимбо)
        div.wingman.btn(data-weapon="wingman" data-category="pistol")
          img(src="/images/wingman.svg", alt="wingman")
          p.name Ведомый
      #fire-mode-select.button-row
        div.fire-mode-btn.fire-mode-auto.tooltip(data-mode="auto")
          span.fire-mode-icon ⮓⮓⮓
          span.fire-mode-text Авто
          span.tooltiptext Автоматический огонь
        div.fire-mode-btn.fire-mode-burst.tooltip(data-mode="burst")
          span.fire-mode-icon ⮓⮓
          span.fire-mode-text Очередь
          span.tooltiptext Стрельба очередями
        div.fire-mode-btn.fire-mode-single.tooltip(data-mode="single")
          span.fire-mode-icon ⮓
          span.fire-mode-text Одиночный
          span.tooltiptext Одиночные выстрелы
        div.fire-mode-hint.tooltip
          span.fire-mode-key [B]
          span.tooltiptext Переключить режим огня [B]
      #mag-select.button-row(class="justify-start")
        div.mag-0.tooltip
          img(src="/images/magi.png" alt="no magazine")
          span.mag-cap
          span.tooltiptext Без магазина
        div.mag-1.tooltip
          img(src="/images/magi.png" alt="magazine level 1")
          span.mag-cap
          span.tooltiptext Ур. 1
        div.mag-2.tooltip
          img(src="/images/magi.png" alt="magazine level 2")
          span.mag-cap
          span.tooltiptext Ур. 2
        div.mag-3.tooltip
          img(src="/images/magi.png" alt="magazine level 3")
          span.mag-cap
          span.tooltiptext Ур. 3
        div.mag-4.tooltip
          img(src="/images/corrupted_mag.svg" alt="corrupted magazine")
          span.mag-cap
          span.tooltiptext Искаженный магазин
        div.mag-drop.tooltip.hidden
          img(src="/images/magi.png" alt="drop magazine")
          span.mag-cap
          span.tooltiptext Фиксированный магазин
        div.mod-revved_up.mod.hidden.tooltip
          img(src="/images/thermite_grenade.png" alt="thermite grenade")
          span.tooltiptext Загрузить зажигательную гранату
        div.mod-corrupted_stock.mod.tooltip
          img(src="/images/barrel_stocki.png" alt="corrupted stock")
          span.tooltiptext Искаженный приклад (-4 патрона, -1 для дробовиков)
      #settings(class="pt-1 pr-1 pb-0 pl-2 *:pt-1")
          #mouse-settings(class="flex items-center justify-between pr-[10px]")
            div
              input(class="w-[5ch]" type='text' id='sens' aria-label="Чувствительность мыши")
              span.tooltip.underlined
                | Чувств.
                span.tooltiptext
                  | Например: если чувствительность в игре 3 и ADS<br/>
                  | 1.2 впишите сюда 3 * 1.2 = 3.6
            div.scale-x-wrapper
              input(class="w-[5ch]" type='text' id='scale-x')
              span
                | x&nbsp;
            div
              input(class="w-[5ch]" type='text' id='scale-y')
              span
                | масшт.
            #invert-y-btn.btn
              div Инверт. Y
          p Режим цели:
          #mode-selection.button-row
            #mode-fixed-path.btn.tooltip
              div Траектория
              span.tooltiptext Клавиша A
            #mode-fixed.btn.tooltip
              div Неподвижная
              span.tooltiptext Клавиша S
            #mode-moving.btn.tooltip
              div Движущаяся
              span.tooltiptext Клавиша D
          div(class="flex items-center justify-between")
            .tooltip
              img(src="/outline_run_circle_white_24dp.png" alt="target control")
              span.tooltiptext
                | Скорость цели
            input.slider#target-speed(type='range' min="1" max="600" step="1")
            #target-speed-value(class="grow text-center")
          #recoil-mode.button-row
            .center-text Отдача:
            #recoil-weapon.btn.tooltip(class="w-[90px]")
              div Оружия
              span.tooltiptext
                | Отдача применяется к курсору, цель неподвижна
            #recoil-target.btn.tooltip(class="w-[90px]")
              div Цели
              span.tooltiptext
                | Отдача применяется к цели, как в игре
          .button-row
            .center-text Следы:
            #trace-0.btn
              div У цели
            #trace-1.btn
              div Точки
            #trace-2.btn
              div Линии
          div(class="flex items-center justify-between")
            .tooltip
              img(src="/outline_slow_motion_video_white_24dp.png" alt="speed control").tooltip
              span.tooltiptext
                | Скорость стрельбы. Сделайте меньше, если не успеваете
            input.slider#speed(type='range' min="10" max="100" step="10")
            #speed-value(class="grow text-center")
          #sound-control(class="flex items-center justify-between")
            #toggle-mute.tooltip(class="cursor-pointer")
              img(src="/volume_up_white_24dp.svg"  alt="sound is not muted")#unmuted
              img(src="/volume_off_white_24dp.svg" alt="sound is muted")#muted.hidden
              span.tooltiptext
                | Громкость звука (нажмите, чтобы выключить звук)
            input.slider#volume(type='range' min="0" max="100")
            div(class="grow text-center")
      #controls-bottom(class="mt-auto px-1 pt-1 pb-2")
        #copyright(class="mb-1 text-[0.8em]")
          div(class="flex flex-row text-[0.7em]")
            if site.repoUrl
              a(class="m-0.5" href=site.repoUrl target="_blank" rel="noopener noreferrer")
                img(class="border-b border-b-transparent pb-0.5 hover:border-b-foreground" src="/GitHub-Mark-Light-32px.png", alt="GitHub")
            if site.communityUrl
              a(class="mx-1 my-auto text-[15px]" href=site.communityUrl target="_blank" rel="noopener noreferrer")
                | Сообщество
            a(href="/" class="mx-1 my-auto text-[15px]")
              | english
            a(href="/zh-CN" class="mx-1 my-auto text-[15px]")
              | 中文
            div(class="flex flex-col items-end grow")
              if site.privacyUrl
                a(class="m-0.5" href=site.privacyUrl target="_blank" rel="noopener noreferrer")
                  | Privacy Policy
              if analytics
                a(class="m-0.5" href="#cookies")
                  | Cookie settings
          p
            | © #{new Date().getFullYear()} #{site.owner}. Основано на #[a(class="m-0.5" href=site.upstream.url target="_blank" rel="noopener noreferrer") #{site.upstream.name}] (#{site.upstream.author}), #{site.upstream.license}.
          p
            | This app is not affiliated with or sponsored by Electronic Arts Inc. or its licensors. 
            | Game content and materials are trademarks and copyrights of 
            | #[a(class="m-0.5" href="https://ea.com" target="_blank" rel="noopener noreferrer") Electronic Arts Inc.]              
            | or #[a(class="m-0.5" href="https://www.respawn.com/" target="_blank" rel="noopener noreferrer") Respawn Entertainment]. 
            | Some images and reference materials come from 
            | #[a(class="m-0.5" href="https://apexlegends.fandom.com/wiki/" target="_blank" rel="noopener noreferrer") Apex Legends Wiki].
        #version(class="text-right text-[0.8em]")
          p
            | version #[span#version-value 17]&nbsp;
            if site.changelogUrl
              a(href=site.changelogUrl target="_blank" rel="noopener noreferrer")
                | what's new
    #workspace(class="grow overflow-hidden")
      #detailed-stats.hidden(class="bg-menu p-2")
        div Ось Y логарифмическая поскольку разница между 40 и 50 очками меньше, чем между 80 и 90.
        #plotly_area(class="h-[300px]")
        div
          p.action#hide-stats Скрыть график
      #instructions.hidden(class="bg-menu px-5 py-3")
          h2 Инструкция
          if site.videoUrl
            p #[a(href=site.videoUrl target="_blank" rel="noopener noreferrer") Видео объяснение (англ.)].
          ul
            li #[a(href="https://www.google.com/search?q=отключить+Повышение+точности+указателя+windows" target="_blank" rel="noopener noreferrer") Убедитесь, что настройка "повышение точности указателя" выключена].
            li Выставите #[i чувствительность].&nbsp;            
            li Выберите оружие и уровень магазина.
            li Нажмите в обведенной точками области внизу и попробуйте компенсировать отдачу. Чем лучше получается это делать, тем больше очков вы наберете (максимум 100).
          p При наведении на многие настройки и кнопки появится всплывающая подсказка.
          p
            if site.faqUrl
              a(href=site.faqUrl+'#controller-support' target="_blank" rel="noopener noreferrer") Настройка для игры с контроллером (англ., экспериментально).
          p.action#dismiss-instructions Закрыть инструкцию
      #stage
  #mobile-info(class="text-center desktop:hidden mobile:block mobile:relative mobile:h-full")
    h1 Apex Legends Recoil Patterns
    p Привет! Этот сайт позволят практиковать отдачу оружия в игре Apex Legends.
      | Размер экрана устройства должен быть больше чем 900 пикселей.
    br
    p Увидимся!
    img(class="mobile:py-4" src="/trail.png", alt="trail")
    #copyright-mobile(class="mobile:absolute mobile:bottom-[50px] mobile:text-[0.8em]")
      if site.privacyUrl
        p
          a(href=site.privacyUrl target="_blank" rel="noopener noreferrer")
            | Privacy Policy
      if analytics
        p
          a(href="#cookies")
            | Cookie settings
      p © #{new Date().getFullYear()} #{site.owner}
      p Based on #[a(href=site.upstream.url target="_blank" rel="noopener noreferrer") #{site.upstream.name}] by #{site.upstream.author}, #{site.upstream.license}.
      p This app is not affiliated with or sponsored by Electronic Arts Inc. or its licensors.
  script.
    window.game_locale = 'ru';